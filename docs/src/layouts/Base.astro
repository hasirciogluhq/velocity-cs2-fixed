---
import '@fontsource-variable/rethink-sans';
import '@fontsource-variable/jetbrains-mono';
import '../styles/site.css';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const repo = 'https://github.com/hasirciogluhq/velocity-cs2-fixed';
const here = Astro.url.pathname;
const links = [
  { href: `${base}combat/`, label: 'Combat' },
  { href: `${base}visuals/`, label: 'Visuals' },
  { href: `${base}skins/`, label: 'Skins' },
  { href: `${base}world/`, label: 'World' },
  { href: `${base}movement/`, label: 'Movement' },
  { href: `${base}menu/`, label: 'Menu' },
];
const pageTitle = here === base ? 'velocity docs' : `${title} | velocity docs`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <title>{pageTitle}</title>
    <style is:global>html, body { overflow-x: clip; }</style>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="nav">
      <div class="container nav__row">
        <a class="wordmark" href={base} aria-label="velocity docs home">velocity</a>
        <nav aria-label="Documentation">
          <ul class="nav__links">
            {links.map((l) => (
              <li><a href={l.href} aria-current={here === l.href ? 'page' : undefined}>{l.label}</a></li>
            ))}
            <li><a class="nav__repo" href={`${repo}/releases`}>Download</a></li>
          </ul>
        </nav>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="footer">
      <div class="container footer__grid">
        <p class="footer__mark">velocity</p>
        <p class="footer__note">
          A Counter-Strike 2 client mod for offline play against bots. Not affiliated with or endorsed by Valve.
          These pages update with every stable release.
        </p>
        <ul class="footer__links">
          <li><a href={`${base}disclaimer/`}>Disclaimer</a></li>
          <li><a href={repo}>Source</a></li>
          <li><a href={`${repo}/releases`}>Releases</a></li>
        </ul>
      </div>
    </footer>
  </body>
</html>
